process_testcase_our() {
    echo "调用了处理函数: our"
    process_testcase "$@" # todo实现正确的ourmethod处理
}

# 记得先编译
pushd "/workspaces/llvmta/build" || echo "Unable to compile"
    echo "compiling..."
    ninja -j4 || exit
popd || exit

# 主逻辑
case "$1" in
    batchtest)
        MODE="${2:-default}"  # 默认为 default

        TEST_DIR="${BENCHMARK_DIR}/$1"
        if [ ! -d "$TEST_DIR" ]; then
            echo "错误：找不到test目录 $TEST_DIR" >&2
            exit 2
        fi
        > "$TEST_DIR/out.xml"
        > "$TEST_DIR/out.txt"
        > "$TEST_DIR/Zhao_Output.txt"

        for dir in "$TEST_DIR"/*; do
            if [ -d "$dir" ]; then
                case "$(basename "$dir")" in
                    h264_dec|g723_enc|ndes)
                        continue ;;
                    *)
                        USEROPTS=()
                        case "$MODE" in
                            liangy) process_testcase_liangy "$dir" ;;
                            zhangw) process_testcase_zhangw "$dir" ;;
                            our)    process_testcase_our "$dir" ;;
                            intr)   process_testcase_intr "$dir" ;;  # 默认
                        esac
                        ;;
                esac
            fi
        done
        ;;
    *)
        TESTCASE="$1"
        MODE="${2:-default}"

        TESTCASE_DIR=$(find "$BENCHMARK_DIR" -type d -wholename "*/$TESTCASE" ! -wholename "*/build/*")
        TEST_DIR=$TESTCASE_DIR

        if [ ! -d "$TESTCASE_DIR" ]; then
            echo "无法找到测试用例: $TESTCASE" >&2
            exit 2
        fi

        case "$MODE" in
            liangy) process_testcase_liangy "$TESTCASE_DIR" ;;
            zhangw) process_testcase_zhangw "$TESTCASE_DIR" ;;
            our)    process_testcase_our "$TESTCASE_DIR" ;;
            intr)   process_testcase_intr "$TESTCASE_DIR" ;;
        esac
        ;;

esac

exit 0
